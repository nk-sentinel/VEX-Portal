# --- Adapter mode: FAKE (default, safe for local dev) or REAL ---
# REAL requires IQ_BASE_URL, JFROG_BASE_URL and BITBUCKET_BASE_URL to all be set.
ADAPTER_MODE=fake

# --- Fake servers (used when ADAPTER_MODE=fake) ---
FAKE_IQ_URL=http://localhost:9101
FAKE_JFROG_URL=http://localhost:9102
FAKE_BITBUCKET_URL=http://localhost:9103
FAKE_BEDROCK_URL=http://localhost:9104

# --- Nexus IQ ---
IQ_BASE_URL=https://iq.example.internal
IQ_SERVICE_USER=svc-vex
IQ_SERVICE_TOKEN=

# --- Bitbucket Data Center ---
BITBUCKET_BASE_URL=https://bitbucket.example.internal
# In ADAPTER_MODE=fake, leaving this empty is a KNOWN BUG, not a safe
# default: BitbucketHttpClient/JFrogHttpClient build a static
# `Authorization: Bearer {token}` header, and an empty token produces the
# illegal header value "Bearer " (trailing space), which httpx refuses to
# send client-side — every call fails before it leaves the container,
# misreported as "could not be reached" (see the 2026-09-01 screens task
# report). Set a non-empty placeholder for fake-mode use; the fakes do not
# validate its value.
BITBUCKET_TOKEN=

# --- JFrog Artifactory ---
JFROG_BASE_URL=https://artifactory.example.internal
# Same bug, same fix — see BITBUCKET_TOKEN above.
JFROG_TOKEN=

# --- ELK (SBOM + vulnerability data per scan) ---
ELK_BASE_URL=https://elk.example.internal
ELK_INDEX=sbom-scans-*
ELK_TOKEN=

# --- Bedrock (private VPC endpoint) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=claude-opus-5
BEDROCK_ENDPOINT_URL=

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/vex.db

# --- Auth / sessions ---
# AUTH_PROVIDER: local (default, DB-backed, for shadowlab + break-glass) or ldap.
# Defaults to local so a missing/unset value never locks everyone out.
AUTH_PROVIDER=local
SESSION_SECRET=
# Hours a session cookie stays valid after login. A security parameter —
# review before changing, not a value to bump casually.
SESSION_TTL_HOURS=12
# Must be true in any deployment reachable from outside the host (this app
# sees plain HTTP behind Traefik even in production — Cloudflare terminates
# TLS at the edge — so this cannot be inferred, only configured). false only
# for local HTTP development.
SESSION_COOKIE_SECURE=true

# --- Directory / RBAC (AUTH_PROVIDER=ldap) ---
LDAP_URL=ldaps://ad.example.internal
LDAP_BASE_DN=
# The DN template to bind as, e.g. uid={username},{base_dn} or
# {username}@example.com for AD UPN binds. Left empty, app/auth/ldap.py
# falls back to uid={username},{base_dn} — an assumption, unverified
# against a real directory. Set explicitly once the real directory's DN
# shape is known; see the Task 1-3 report's "verify at work" list.
LDAP_BIND_DN_TEMPLATE=
# One AD group DN per role. A role with no group set here is simply
# unreachable over LDAP for anyone — never given a default.
LDAP_GROUP_REQUESTER=
LDAP_GROUP_REVIEWER=
LDAP_GROUP_APPROVER=
LDAP_GROUP_AUDITOR=
LDAP_GROUP_RISK_MANAGER=
LDAP_GROUP_ADMIN=
